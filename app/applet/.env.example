# GEMINI_API_KEY: Required for Gemini AI code review and complexity analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing and verifying user session tokens.
JWT_SECRET="your-jwt-secret-key-production"

# GITHUB_CLIENT_ID: Optional GitHub OAuth App client ID for real GitHub account linking.
GITHUB_CLIENT_ID="your-github-client-id"

# GITHUB_CLIENT_SECRET: Optional GitHub OAuth App client secret.
GITHUB_CLIENT_SECRET="your-github-client-secret"

# PORT: Server port (defaults to 3000 in dev environment)
PORT=3000
